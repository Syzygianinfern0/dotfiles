[init]
    defaultBranch = main
[core]
    editor = nano
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- if eq .chezmoi.os "darwin" }}
[credential]
	helper = osxkeychain
{{- with lookPath "gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{- end }}
{{- else }}
[credential]
	helper = store
{{- end }}
