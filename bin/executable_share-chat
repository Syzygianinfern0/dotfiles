#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["markdown-it-py>=3", "pygments>=2.17"]
# ///
"""Render a Claude Code or Codex session as a clean, shareable HTML page.

Looks like a chat share page: the human's messages as bubbles, the agent's
replies as prose, and each run of tool calls / reasoning folded into one
"Worked · ran 3 commands" line that expands. One self-contained file.

Usage:
  share-chat [session-id|path] [-o out.html]   # render to a file
  share-chat [session] --check                 # scan for secrets / emails only
  share-chat [session] --publish               # publish to Netlify, print the link
  share-chat [session] --unpublish             # take it down again
  share-chat --list                            # published chats and links
Options: --title T, --no-steps, --redact STR (repeatable), --turns 1-3,5, --force

With no session it uses the newest Claude Code or Codex session for the
current folder. Published chats live in one Netlify site (created on first
use; ID kept in ~/.config/share-chat/config.json) under unguessable paths;
the local copy of the site is ~/.local/share/share-chat/site.
"""
import argparse, html, io, json, os, re, secrets, shutil, subprocess, sys, tempfile
from datetime import datetime
from pathlib import Path

from markdown_it import MarkdownIt
from pygments import highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import get_lexer_by_name, guess_lexer
from pygments.util import ClassNotFound

HOME = Path.home()
CLAUDE_PROJECTS = HOME / ".claude" / "projects"
CODEX = HOME / ".codex"
CODEX_GLOBS = ("sessions/*/*/*/*.jsonl", "sessions/*/*/*/*.jsonl.zst",
               "archived_sessions/*.jsonl", "archived_sessions/*.jsonl.zst")

# ── locating / opening sessions (same rules as ~/bin/chat2md) ────────────────

def open_text(path):
    path = Path(path)
    if path.suffix != ".zst":
        return open(path, encoding="utf-8")
    try:
        from compression import zstd
        return zstd.open(path, "rt", encoding="utf-8")
    except ImportError:
        out = subprocess.run(["zstd", "-dcq", str(path)], capture_output=True)
        if out.returncode:
            sys.exit(f"can't decompress {path}")
        return io.StringIO(out.stdout.decode("utf-8", "replace"))


def records(path):
    for line in open_text(path):
        try:
            yield json.loads(line)
        except json.JSONDecodeError:
            pass


def session_name(path):
    n = Path(path).name
    for ext in (".jsonl.zst", ".jsonl"):
        if n.endswith(ext):
            return n[: -len(ext)]
    return n


def claude_project_dir(cwd):
    return CLAUDE_PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def codex_files():
    return [p for g in CODEX_GLOBS for p in CODEX.glob(g)]


def first_record(path):
    return next(records(path), {})


def resolve(arg):
    if not arg:
        cwd = os.getcwd()
        cands = list(claude_project_dir(cwd).glob("*.jsonl"))
        recent = sorted(codex_files(), key=lambda p: p.stat().st_mtime, reverse=True)[:100]
        cands += [p for p in recent if (first_record(p).get("payload") or {}).get("cwd") == cwd]
        if not cands:
            sys.exit(f"no sessions found for {cwd}")
        return max(cands, key=lambda p: p.stat().st_mtime)
    if os.path.isfile(arg):
        return Path(arg)
    hits = list(CLAUDE_PROJECTS.glob(f"*/{arg}.jsonl"))
    hits += [p for p in codex_files() if session_name(p).endswith(arg)]
    if not hits:
        sys.exit(f"session not found: {arg}")
    return hits[0]

# ── common model ─────────────────────────────────────────────────────────────
# A session is a list of turns: {"user": str, "time": iso, "items": [...]}
# where items are {"kind": "text", "text": md}
#              or {"kind": "step", "tool": name, "label": short, "input": str,
#                  "output": str, "images": [data-uri], "lang": str}
#              or {"kind": "thought", "text": str}
#              or {"kind": "event", "text": str}   (e.g. a background agent finished)


def add(cur, rec, item):
    item["ts"] = rec.get("timestamp")
    cur["items"].append(item)


def short(s, n=90):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def tool_text(content):
    """Flatten a tool result's content into (text, [image data URIs])."""
    if content is None:
        return "", []
    if isinstance(content, str):
        return content, []
    texts, imgs = [], []
    for b in content:
        if not isinstance(b, dict):
            continue
        if b.get("type") in ("text", "input_text", "output_text"):
            texts.append(b.get("text", ""))
        elif b.get("type") == "image":
            src = b.get("source") or {}
            if src.get("type") == "base64":
                imgs.append(f"data:{src.get('media_type', 'image/png')};base64,{src['data']}")
        elif b.get("type") == "input_image" and b.get("image_url"):
            imgs.append(b["image_url"])
    return "\n".join(texts), imgs


CLAUDE_TOOL_LABELS = {
    "Bash": lambda i: i.get("description") or short(i.get("command", "")),
    "Read": lambda i: "Read " + Path(i.get("file_path", "")).name,
    "Write": lambda i: "Wrote " + Path(i.get("file_path", "")).name,
    "Edit": lambda i: "Edited " + Path(i.get("file_path", "")).name,
    "MultiEdit": lambda i: "Edited " + Path(i.get("file_path", "")).name,
    "Glob": lambda i: "Searched files for " + i.get("pattern", ""),
    "Grep": lambda i: "Searched code for " + short(i.get("pattern", ""), 50),
    "WebSearch": lambda i: "Searched the web: " + short(i.get("query", ""), 70),
    "WebFetch": lambda i: "Read " + re.sub(r"^https?://(www\.)?", "", i.get("url", "")).split("/")[0],
    "Agent": lambda i: "Subagent: " + i.get("description", ""),
    "Task": lambda i: "Subagent: " + i.get("description", ""),
    "Skill": lambda i: "Used skill " + i.get("skill", ""),
    "TodoWrite": lambda i: "Updated the to-do list",
    "ToolSearch": lambda i: "Loaded tools",
}

LANG_BY_EXT = {".py": "python", ".js": "javascript", ".ts": "typescript", ".sh": "bash",
               ".json": "json", ".html": "html", ".css": "css", ".md": "markdown",
               ".tex": "latex", ".yaml": "yaml", ".yml": "yaml", ".toml": "toml"}


def claude_step(block):
    name, inp = block.get("name", "tool"), block.get("input") or {}
    label_fn = CLAUDE_TOOL_LABELS.get(name)
    try:
        label = label_fn(inp) if label_fn else name.split("__")[-1].replace("_", " ")
    except Exception:
        label = name
    lang = "text"
    if name == "Bash":
        body, lang = inp.get("command", ""), "bash"
    elif name in ("Write",):
        body = inp.get("content", "")
        lang = LANG_BY_EXT.get(Path(inp.get("file_path", "")).suffix, "text")
    elif name in ("Edit",):
        body = "\n".join(["- " + l for l in inp.get("old_string", "").splitlines()] +
                         ["+ " + l for l in inp.get("new_string", "").splitlines()])
        lang = "diff"
    elif name in ("Agent", "Task"):
        body, lang = inp.get("prompt", ""), "markdown"
    else:
        body, lang = json.dumps(inp, indent=2, ensure_ascii=False), "json"
    return {"kind": "step", "tool": name, "label": label, "input": body, "lang": lang,
            "output": "", "images": [], "id": block.get("id")}


NOISE_TAGS = ("system-reminder", "command-name", "command-message", "command-args",
              "local-command-stdout", "local-command-caveat")


def clean_user_text(t):
    for tag in NOISE_TAGS:
        t = re.sub(rf"<{tag}>.*?</{tag}>", "", t, flags=re.S)
    t = re.sub(r"</?pasted_content[^>]*>", "", t)
    return t.strip()


def parse_claude(path):
    title, model, turns, cur, pending, by_id = None, None, [], None, {}, {}
    for rec in records(path):
        t = rec.get("type")
        if t in ("ai-title", "summary"):
            title = rec.get("aiTitle") or rec.get("title") or rec.get("summary") or title
        if rec.get("isSidechain") or rec.get("isMeta") or rec.get("isCompactSummary"):
            continue
        att = rec.get("attachment") or {}
        if t == "attachment" and att.get("type") == "queued_command" and \
                (att.get("origin") or {}).get("kind") == "human" and att.get("prompt", "").strip():
            # a message the human sent while the agent was still working
            cur = {"user": clean_user_text(att["prompt"]), "time": att.get("timestamp") or rec.get("timestamp"),
                   "items": []}
            turns.append(cur)
            continue
        if t == "user":
            c = rec["message"]["content"]
            if isinstance(c, list) and any(b.get("type") == "tool_result" for b in c):
                for b in c:
                    if b.get("type") == "tool_result" and b.get("tool_use_id") in pending:
                        txt, imgs = tool_text(b.get("content"))
                        st = pending.pop(b["tool_use_id"])
                        if txt.startswith("Async agent launched"):
                            txt = ""  # real result arrives later in a task-notification
                        st["output"], st["images"] = txt, imgs
                        st["error"] = bool(b.get("is_error"))
                continue
            text = c if isinstance(c, str) else "\n\n".join(
                b.get("text", "") for b in c if b.get("type") == "text")
            if "<task-notification>" in text:
                m = re.search(r"<summary>(.*?)</summary>", text, re.S)
                r = re.search(r"<result>(.*?)</result>", text, re.S)
                u = re.search(r"<tool-use-id>(.*?)</tool-use-id>", text, re.S)
                label = (m.group(1) if m else "Background task finished").strip()
                result = html.unescape(r.group(1).strip()) if r else ""
                if u and u.group(1) in by_id and result:
                    by_id[u.group(1)]["output"] = result
                    by_id[u.group(1)]["output_md"] = True
                    result = ""  # shown on the subagent step already
                if cur:
                    add(cur, rec, {"kind": "event", "text": label, "result": result})
                continue
            if text.lstrip().startswith("[Request interrupted"):
                continue
            text = clean_user_text(text)
            if not text:
                continue
            cur = {"user": text, "time": rec.get("timestamp"), "items": []}
            turns.append(cur)
        elif t == "assistant" and cur:
            msg = rec["message"]
            model = msg.get("model") or model
            for b in msg.get("content", []):
                bt = b.get("type")
                if bt == "text" and b["text"].strip():
                    add(cur, rec, {"kind": "text", "text": b["text"].strip()})
                elif bt == "thinking" and b.get("thinking", "").strip():
                    add(cur, rec, {"kind": "thought", "text": b["thinking"].strip()})
                elif bt == "tool_use":
                    st = claude_step(b)
                    pending[b["id"]] = by_id[b["id"]] = st
                    add(cur, rec, st)
    if model and model.startswith("<"):
        model = None
    return {"agent": "Claude Code", "title": title, "model": model, "turns": turns}


CODEX_NOISE = ("<", "# AGENTS.md instructions")


def codex_title(sid):
    title = None
    try:
        for rec in records(CODEX / "session_index.jsonl"):
            if rec.get("id") == sid:
                title = rec.get("thread_name") or title
    except OSError:
        pass
    return title


def codex_step(p):
    name = p.get("name", "tool")
    raw = p.get("arguments") if p.get("type") == "function_call" else p.get("input", "")
    lang, label, body = "text", name, raw or ""
    try:
        args = json.loads(raw) if p.get("type") == "function_call" else None
    except (TypeError, json.JSONDecodeError):
        args = None
    if isinstance(args, dict):
        cmd = args.get("cmd") or args.get("command")
        if isinstance(cmd, list):
            cmd = " ".join(cmd[2:] if cmd[:2] in (["bash", "-lc"], ["zsh", "-lc"]) else cmd)
        if cmd:
            body, lang, label = cmd, "bash", short(cmd)
        else:
            body, lang = json.dumps(args, indent=2, ensure_ascii=False), "json"
    if name == "apply_patch":
        label, lang = "Edited files", "diff"
        files = re.findall(r"\*\*\* (?:Update|Add) File: (.+)", body)
        if files:
            label = "Edited " + ", ".join(Path(f).name for f in files[:3])
    elif name == "exec" and p.get("type") == "custom_tool_call":
        lang = "javascript"
        m = re.findall(r"tools\.(\w+)", body)
        label = "Ran " + ", ".join(dict.fromkeys(x.replace("__", " ").replace("_", " ") for x in m)) if m else "Ran a script"
    return {"kind": "step", "tool": name, "label": label, "input": body, "lang": lang,
            "output": "", "images": [], "id": p.get("call_id")}


def parse_codex(path):
    sid, model, turns, cur, pending = None, None, [], None, {}
    for rec in records(path):
        p = rec.get("payload") or {}
        typ = rec.get("type")
        if typ == "session_meta":
            sid = p.get("id") or p.get("session_id")
            continue
        if typ == "turn_context":
            model = p.get("model") or model
            continue
        if typ == "event_msg" and p.get("type") == "thread_settings_applied":
            model = (p.get("thread_settings") or {}).get("model") or model
        if typ != "response_item":
            continue
        kind = p.get("type")
        if kind == "message" and p.get("role") == "user":
            parts = [c.get("text", "").strip() for c in p.get("content", [])
                     if c.get("type") == "input_text"]
            parts = [x for x in parts if x and not x.startswith(CODEX_NOISE)]
            if parts:
                cur = {"user": "\n\n".join(parts), "time": rec.get("timestamp"), "items": []}
                turns.append(cur)
        elif not cur:
            continue
        elif kind == "message" and p.get("role") == "assistant":
            for c in p.get("content", []):
                if c.get("type") == "output_text" and c.get("text", "").strip():
                    add(cur, rec, {"kind": "text", "text": c["text"].strip()})
        elif kind == "reasoning":
            txt = "\n\n".join(s.get("text", "") for s in p.get("summary") or [])
            if txt.strip():
                add(cur, rec, {"kind": "thought", "text": txt.strip()})
        elif kind in ("function_call", "custom_tool_call", "local_shell_call", "web_search_call"):
            if kind == "web_search_call":
                q = (p.get("action") or {}).get("query", "")
                add(cur, rec, {"kind": "step", "tool": "web_search", "label": "Searched the web: " + short(q, 70),
                                     "input": q, "lang": "text", "output": "", "images": []})
                continue
            st = codex_step(p)
            pending[st["id"]] = st
            add(cur, rec, st)
        elif kind in ("function_call_output", "custom_tool_call_output"):
            st = pending.pop(p.get("call_id"), None)
            if st:
                out = p.get("output")
                if isinstance(out, str):
                    try:
                        j = json.loads(out)
                        out = j.get("output", out) if isinstance(j, dict) else out
                    except json.JSONDecodeError:
                        pass
                st["output"], st["images"] = tool_text(out) if not isinstance(out, str) else (out, [])
    return {"agent": "Codex", "title": codex_title(sid) if sid else None, "model": model, "turns": turns}

# ── rendering ────────────────────────────────────────────────────────────────

FMT = HtmlFormatter(nowrap=True)


def hl(code, lang):
    try:
        lexer = get_lexer_by_name(lang or "text")
    except ClassNotFound:
        try:
            lexer = guess_lexer(code)
        except ClassNotFound:
            lexer = get_lexer_by_name("text")
    return highlight(code, lexer, FMT)


def md_highlight(code, lang, _attrs):
    label = html.escape(lang or "")
    return (f'<div class="code"><div class="code-head"><span>{label}</span>'
            f'<button class="copy" type="button">Copy</button></div>'
            f'<pre><code>{hl(code, lang)}</code></pre></div>')


MD = MarkdownIt("commonmark", {"html": False, "linkify": False, "highlight": md_highlight,
                               "breaks": False}).enable(["table", "strikethrough"])


def md(text):
    out = MD.render(text)
    # markdown-it wraps highlighted output in <pre><code>; unwrap our own block
    out = re.sub(r'<pre><code[^>]*>(<div class="code">.*?</div>)\s*</code></pre>', r"\1", out, flags=re.S)
    return out.replace("<a href=", '<a target="_blank" rel="noopener" href=')


def user_html(text):
    # Human messages: keep line breaks, light markdown only if it looks like markdown.
    if re.search(r"^(#{1,6} |[-*] |\d+\. |```)", text, re.M):
        return md(text)
    return "".join(f"<p>{html.escape(p).replace(chr(10), '<br>')}</p>"
                   for p in re.split(r"\n\s*\n", text) if p.strip())


def clip(s, n=4000):
    s = s.rstrip()
    if len(s) <= n:
        return s
    return s[:n] + f"\n… ({len(s) - n:,} more characters)"


def parse_ts(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except Exception:
        return None


def fmt_dur(sec):
    sec = int(round(sec))
    if sec < 60:
        return f"{max(sec, 1)}s"
    m, s = divmod(sec, 60)
    if m < 60:
        return f"{m}m {s}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h {m}m"


def segments(turn):
    """Split a turn into responses. Each response is (start_ts, work_items, final_items).

    A background-task notification starts a new response, as it does in the chat.
    The final answer is the text after the last tool call; everything before it
    (progress notes, tool calls, thinking) is the hidden "work"."""
    segs, cur, start = [], [], turn.get("time")
    for it in turn["items"]:
        if it["kind"] == "event":
            segs.append((start, cur, it))
            cur, start = [], it.get("ts")
        else:
            cur.append(it)
    segs.append((start, cur, None))
    out = []
    for start, items, event in segs:
        last_step = max((i for i, x in enumerate(items) if x["kind"] != "text"), default=-1)
        work, final = items[: last_step + 1], items[last_step + 1:]
        if not final and work:  # no reply after the last step: show the last text anyway
            idx = max((i for i, x in enumerate(work) if x["kind"] == "text"), default=None)
            if idx is not None:
                final = [work[idx]]
                work = work[:idx] + work[idx + 1:]
        out.append((start, work, final, event))
    return out


ICONS = {
    "step": '<svg viewBox="0 0 16 16"><path d="M3 4l3 4-3 4M8 12h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    "search": '<svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.2 10.2L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
    "file": '<svg viewBox="0 0 16 16"><path d="M4 2h5l3 3v9H4z M9 2v3h3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>',
    "edit": '<svg viewBox="0 0 16 16"><path d="M3 13l1-3.5L10.5 3 13 5.5 6.5 12z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>',
    "globe": '<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.6 8h10.8M8 2.4c-2 2.2-2 9 0 11.2M8 2.4c2 2.2 2 9 0 11.2" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>',
    "agent": '<svg viewBox="0 0 16 16"><circle cx="8" cy="5.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 13.5c.6-2.6 2.4-4 4.5-4s3.9 1.4 4.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
    "thought": '<svg viewBox="0 0 16 16"><path d="M8 2.5a4 4 0 0 0-2.3 7.3V12h4.6V9.8A4 4 0 0 0 8 2.5zM6.3 14h3.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    "done": '<svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
}

TOOL_ICON = {"WebSearch": "search", "web_search": "search", "Grep": "search", "Glob": "search",
             "Read": "file", "Write": "edit", "Edit": "edit", "MultiEdit": "edit", "apply_patch": "edit",
             "WebFetch": "globe", "Agent": "agent", "Task": "agent"}


def step_html(s):
    if s["kind"] == "thought":
        return (f'<details class="step"><summary class="step-row">{ICONS["thought"]}<span>Thinking</span></summary>'
                f'<div class="step-body prose small">{md(s["text"])}</div></details>')
    if s["kind"] == "text":  # a progress note between tool calls
        return f'<div class="note prose">{md(s["text"])}</div>'
    body = ""
    if s["input"].strip():
        body += f'<pre class="io"><code>{hl(clip(s["input"], 3000), s["lang"])}</code></pre>'
    if s["output"].strip() and s.get("output_md"):
        body += f'<div class="report prose small">{md(s["output"])}</div>'
    elif s["output"].strip():
        cls = "io out err" if s.get("error") else "io out"
        body += f'<pre class="{cls}"><code>{html.escape(clip(s["output"]))}</code></pre>'
    for src in s["images"]:
        body += f'<img class="shot" loading="lazy" src="{src}" alt="">'
    icon = ICONS[TOOL_ICON.get(s["tool"], "step")]
    row = f'{icon}<span>{html.escape(s["label"])}</span>'
    if not body:
        return f'<div class="step"><div class="step-row">{row}</div></div>'
    return (f'<details class="step"><summary class="step-row">{row}<i class="chev"></i></summary>'
            f'<div class="step-body">{body}</div></details>')


def work_label(start, work, final):
    t0 = parse_ts(start or "")
    t1 = parse_ts((final[0] if final else work[-1]).get("ts") or "")
    only_thought = all(w["kind"] == "thought" for w in work)
    verb = "Thought" if only_thought else "Worked"
    if t0 and t1 and t1 > t0:
        return f"{verb} for {fmt_dur((t1 - t0).total_seconds())}"
    n = sum(1 for w in work if w["kind"] == "step")
    return f"{verb}" + (f" · {n} step{'s' if n != 1 else ''}" if n else "")


def render_turn_agent(turn, show_steps):
    out = []
    for start, work, final, event in segments(turn):
        if work and show_steps:
            out.append(f'<details class="work"><summary>{html.escape(work_label(start, work, final))}<i class="chev"></i></summary>'
                       f'<div class="steps">{"".join(step_html(s) for s in work)}</div></details>')
        for it in final:
            out.append(f'<div class="prose answer">{md(it["text"])}</div>')
        if event:
            out.append(f'<div class="event">{ICONS["done"]}<span>{html.escape(event["text"])}</span></div>')
    return "".join(out)


def fmt_model(m):
    if not m:
        return None
    m = re.sub(r"-\d{8}$", "", m)
    pretty = {"claude-opus-5-5": "Opus 5.5", "claude-sonnet-5-5": "Sonnet 5.5", "claude-fable-5-2": "Fable 5.2",
              "claude-haiku-5-5": "Haiku 5.5"}
    if m in pretty:
        return pretty[m]
    g = re.match(r"gpt-([\d.]+)(?:-(.+))?$", m)
    if g:
        return f"GPT-{g.group(1)}" + (f" {g.group(2).replace('-', ' ').title()}" if g.group(2) else "")
    return m


def fmt_date(iso):
    d = parse_ts(iso or "")
    return d.astimezone().strftime("%b %-d, %Y") if d else ""


def render(sess, show_steps=True):
    turns = sess["turns"]
    plain = re.sub(r"[#*_`>\[\]]+", "", turns[0]["user"])
    title = sess["title"] or short(plain, 70)
    meta = " · ".join(x for x in (fmt_model(sess["model"]), fmt_date(turns[0].get("time"))) if x)
    body = "".join(
        f'<section class="turn"><div class="user"><div class="bubble prose">{user_html(t["user"])}</div></div>'
        f'<div class="agent">{render_turn_agent(t, show_steps)}</div></section>' for t in turns)
    sel = [".prose pre", "pre.io"]
    css = (HtmlFormatter(style="default").get_style_defs(sel)
           + "@media (prefers-color-scheme:dark){" + HtmlFormatter(style="github-dark").get_style_defs(sel) + "}"
           + PAGE_CSS)
    theme = "codex" if sess["agent"] == "Codex" else "claude"
    return PAGE.format(title=html.escape(title), meta=html.escape(meta), body=body, css=css,
                       agent=html.escape(sess["agent"]), theme=theme, js=PAGE_JS, globe=ICONS["globe"])


