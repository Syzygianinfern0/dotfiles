document.querySelectorAll('.answer a[href^="http"], .note a[href^="http"]').forEach(a=>{
  const s=document.createElement('span');s.className='gl';s.innerHTML=g;a.prepend(s);
});
"""


# ── privacy ──────────────────────────────────────────────────────────────────

def scrub(obj, subs):
    if isinstance(obj, str):
        if obj.startswith("data:image/"):
            return obj
        for a, b in subs:
            obj = obj.replace(a, b)
        return obj
    if isinstance(obj, list):
        return [scrub(x, subs) for x in obj]
    if isinstance(obj, dict):
        return {k: scrub(v, subs) for k, v in obj.items()}
    return obj


def pick_turns(turns, spec):
    keep = set()
    for part in spec.split(","):
        a, _, b = part.partition("-")
        keep.update(range(int(a), int(b or a) + 1))
    return [t for i, t in enumerate(turns, 1) if i in keep]


# ── publishing ───────────────────────────────────────────────────────────────

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "share-chat" / "config.json"
SITE_DIR = Path(os.environ.get("SHARE_CHAT_SITE", HOME / ".local" / "share" / "share-chat" / "site"))

SECRET_PATTERNS = [
    ("private key", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("OpenAI/Anthropic key", r"\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}"),
    ("GitHub token", r"\b(?:ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}"),
    ("AWS key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("Slack token", r"\bxox[abprs]-[A-Za-z0-9-]{10,}"),
    ("Google API key", r"\bAIza[0-9A-Za-z_-]{35}\b"),
    ("password/token assignment", r"(?i)\b(?:password|passwd|secret|api[_-]?key|token)\s*[=:]\s*['\"]?[^\s'\"<]{8,}"),
]
EMAIL = r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"


def load_config():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, json.JSONDecodeError):
        return {"sessions": {}}


def save_config(cfg):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2))


def scan(page_html):
    """Return a list of human-readable findings: likely secrets and email addresses."""
    text = re.sub(r"data:image/[^\"']+", "", page_html)  # skip embedded screenshots
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    found = []
    for name, pat in SECRET_PATTERNS:
        for m in re.finditer(pat, text):
            found.append(f"{name}: {m.group(0)[:12]}…")
    emails = sorted(set(re.findall(EMAIL, text)) - {"noreply@anthropic.com"})
    found += [f"email address: {e}" for e in emails]
    if shutil.which("gitleaks"):
        with tempfile.TemporaryDirectory() as d:
            Path(d, "page.txt").write_text(text)
            r = subprocess.run(["gitleaks", "detect", "--no-git", "--no-banner", "--redact", "-s", d,
                                "-f", "json", "-r", str(Path(d, "out.json"))], capture_output=True, text=True)
            try:
                for f in json.loads(Path(d, "out.json").read_text() or "[]"):
                    found.append(f"gitleaks {f.get('RuleID')}: line {f.get('StartLine')}")
            except (OSError, json.JSONDecodeError):
                pass
    return list(dict.fromkeys(found))


def slugify(title):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].strip("-")
    return f"{s or 'chat'}-{secrets.token_hex(3)}"


def netlify(*args):
    npx = shutil.which("npx")
    cmd = ["npx", "--yes", "netlify-cli", *args]
    if not npx:  # Node installed through nvm isn't on PATH in non-login shells
        nvm = HOME / ".nvm" / "nvm.sh"
        if not nvm.exists():
            sys.exit("npx not found: install Node (or nvm) to publish")
        cmd = ["bash", "-c", f'. "{nvm}" >/dev/null && exec "$@"', "_", *cmd]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"netlify-cli {' '.join(args[:1])} failed:\n{r.stdout[-1500:]}{r.stderr[-1500:]}")
    return r.stdout


def ensure_site(cfg):
    if cfg.get("site_id"):
        return cfg
    name = f"chats-{secrets.token_hex(4)}"
    out = netlify("sites:create", "--name", name, "--disable-linking")
    m = re.search(r"Project ID:\s*([0-9a-f-]{36})", out) or re.search(r"\b([0-9a-f]{8}-[0-9a-f-]{27})\b", out)
    if not m:
        sys.exit(f"couldn't read the new site's ID from netlify-cli output:\n{out[-1500:]}")
    cfg.update(site_id=m.group(1), site_url=f"https://{name}.netlify.app")
    save_config(cfg)
    print(f"created Netlify site {cfg['site_url']}", file=sys.stderr)
    return cfg


def deploy(cfg):
    SITE_DIR.mkdir(parents=True, exist_ok=True)
    root = SITE_DIR / "index.html"
    if not root.exists():  # no public list of chats at the root
        root.write_text('<!doctype html><meta name="robots" content="noindex"><title>Nothing here</title>')
    (SITE_DIR / "robots.txt").write_text("User-agent: *\nDisallow: /\n")
    netlify("deploy", "--no-build", "--prod", "--dir", str(SITE_DIR), "--site", cfg["site_id"])


def main():
    ap = argparse.ArgumentParser(description="Claude Code / Codex session → shareable HTML page")
    ap.add_argument("session", nargs="?", help="session ID or .jsonl path (default: latest in this folder)")
    ap.add_argument("-o", "--output", help="write the page here (default: index.html; with --publish, the site folder)")
    ap.add_argument("--title")
    ap.add_argument("--no-steps", action="store_true", help="leave tool calls and thinking out entirely")
    ap.add_argument("--redact", action="append", default=[], metavar="STR", help="replace STR with ••• (repeatable)")
    ap.add_argument("--turns", help="keep only these turns, e.g. 1-3,5")
    ap.add_argument("--check", action="store_true", help="scan the page for secrets and emails, don't publish")
    ap.add_argument("--publish", action="store_true", help="publish to the Netlify chats site and print the link")
    ap.add_argument("--force", action="store_true", help="publish even though the scan found something")
    ap.add_argument("--unpublish", action="store_true", help="take a published session down")
    ap.add_argument("--list", action="store_true", help="list published sessions and their links")
    a = ap.parse_args()
    cfg = load_config()

    if a.list:
        for sid, info in cfg.get("sessions", {}).items():
            print(f"{cfg.get('site_url', '?')}/{info['slug']}/\t{info.get('title', '')}\t{sid}")
        return

    path = resolve(a.session)
    sid = session_name(path)

    if a.unpublish:
        info = cfg.get("sessions", {}).pop(sid, None)
        if not info:
            sys.exit(f"{sid} isn't published")
        shutil.rmtree(SITE_DIR / info["slug"], ignore_errors=True)
        deploy(ensure_site(cfg))
        save_config(cfg)
        print(f"took down {cfg['site_url']}/{info['slug']}/", file=sys.stderr)
        return

    sess = (parse_codex if first_record(path).get("type") == "session_meta" else parse_claude)(path)
    if not sess["turns"]:
        sys.exit(f"no messages found in {path}")
    if a.turns:
        sess["turns"] = pick_turns(sess["turns"], a.turns)
    if a.title:
        sess["title"] = a.title
    subs = [(s, "•••") for s in a.redact] + [(str(HOME), "~"), (HOME.name, "user")]
    sess = scrub(sess, subs)
    page = render(sess, show_steps=not a.no_steps)
    n_steps = sum(1 for t in sess["turns"] for i in t["items"] if i["kind"] == "step")
    summary = f"{len(sess['turns'])} turns, {n_steps} tool steps ({path.name})"

    if a.check or a.publish:
        found = scan(page)
        if found:
            print("scan found:\n  " + "\n  ".join(found), file=sys.stderr)
            if not a.force:
                sys.exit(3 if a.publish else 0)  # publish refuses until --force or --redact
        else:
            print("scan: nothing found", file=sys.stderr)
        if a.check:
            return

    if not a.publish:
        out = a.output or "index.html"
        Path(out).write_text(page, encoding="utf-8")
        print(f"wrote {out}: {summary}", file=sys.stderr)
        return

    cfg = ensure_site(cfg)
    info = cfg.setdefault("sessions", {}).get(sid) or {"slug": slugify(sess["title"] or "chat")}
    info["title"] = sess["title"] or ""
    (SITE_DIR / info["slug"]).mkdir(parents=True, exist_ok=True)
    (SITE_DIR / info["slug"] / "index.html").write_text(page, encoding="utf-8")
    deploy(cfg)
    cfg["sessions"][sid] = info
    save_config(cfg)
    print(f"published {summary}", file=sys.stderr)
    print(f"{cfg['site_url']}/{info['slug']}/")


if __name__ == "__main__":
    main()
