#!/usr/bin/env bash
# with-secret: run one command with the API keys of one named purpose.
#
#   with-secret --list                      # purposes on this machine: name, variables, description
#   with-secret <purpose> -- <command...>   # run <command> with that purpose's keys in its environment
#   with-secret --add <purpose>             # create or replace a purpose (interactive; run it yourself)
#
# Each purpose is one file, ~/.config/secrets/<purpose>.env (directory 700, file 600), stored
# age-encrypted in the dotfiles via chezmoi, so `chezmoi update` brings it to every machine.
# File format: an optional first line "# <description>", then KEY=VALUE lines.
#
# Before loading the chosen file, every variable that any purpose file defines is removed from the
# environment, so the command can't pick up a key meant for something else that happened to be
# exported. Files are parsed as data, never sourced. Values are never printed.
#
# Long jobs: tmux new -d -s job 'with-secret <purpose> -- python run.py'  (loads inside the job)
# Works on bash 3.2 (macOS) and later.
set -euo pipefail

dir="${WITH_SECRET_DIR:-$HOME/.config/secrets}"
prog=with-secret

die() { echo "$prog: $*" >&2; exit 2; }

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; }

valid_purpose() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

# Print KEY<TAB>VALUE for each assignment in a file. Skips blanks and comments; accepts an optional
# "export " prefix and one pair of matching surrounding quotes.
parse() {
  local line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#export }"
    [[ "$line" == *=* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k%"${k##*[![:space:]]}"}"
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "$prog: skipping a bad variable name in $1" >&2; continue; }
    if [[ ${#v} -ge 2 && ( ( "$v" == \"*\" ) || ( "$v" == \'*\' ) ) ]]; then v="${v:1:${#v}-2}"; fi
    printf '%s\t%s\n' "$k" "$v"
  done < "$1"
}

list() {
  shopt -s nullglob
  local files=("$dir"/*.env) f name desc vars
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "No purposes on this machine ($dir is empty or missing). Try: chezmoi apply $dir"
    return
  fi
  for f in "${files[@]}"; do
    name="$(basename "$f" .env)"
    desc="$(head -n1 "$f")"; [[ "$desc" == \#* ]] && desc="${desc#\#}" && desc="${desc# }" || desc="(no description)"
    vars="$(parse "$f" | cut -f1 | paste -sd, -)"
    printf '%-20s %-40s %s\n' "$name" "${vars:-"(no variables)"}" "$desc"
  done
}

add() {
  local purpose="$1" f desc name value tmp
  valid_purpose "$purpose" || die "bad purpose name '$purpose' (letters, digits, . _ -)"
  [[ -t 0 ]] || die "--add needs an interactive terminal; run it yourself, not through an agent"
  f="$dir/$purpose.env"
  if [[ -e "$f" ]]; then
    read -r -p "$f exists. Replace it? [y/N] " name
    [[ "$name" == [yY]* ]] || exit 1
  fi
  read -r -p "One-line description (what it's for, which provider project): " desc
  umask 077
  mkdir -p "$dir"; chmod 700 "$dir"
  tmp="$(mktemp "$dir/.tmp.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  printf '# %s\n' "$desc" > "$tmp"
  while :; do
    read -r -p "Variable name (e.g. OPENAI_API_KEY; empty to finish): " name
    [[ -z "$name" ]] && break
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "Not a valid variable name."; continue; }
    read -r -s -p "Value for $name (hidden): " value; echo
    [[ -n "$value" ]] || { echo "Empty value, skipped."; continue; }
    printf '%s=%s\n' "$name" "$value" >> "$tmp"
    value=""
  done
  chmod 600 "$tmp"; mv "$tmp" "$f"; trap - EXIT
  echo "Wrote $f"
  if command -v chezmoi >/dev/null; then
    chezmoi add --encrypt "$f"
    local src; src="$(chezmoi source-path "$f")"
    chezmoi git -- add "$src"
    chezmoi git -- commit -q -m "Add or update secret purpose $purpose" -- "$src"
    chezmoi git -- push -q
    echo "Encrypted, committed and pushed. Other machines get it with: chezmoi update"
  else
    echo "chezmoi not found; the key is only on this machine."
  fi
}

case "${1:-}" in
  ""|-h|--help) usage; exit 0 ;;
  -l|--list) list; exit 0 ;;
  --add) [[ $# -eq 2 ]] || die "usage: $prog --add <purpose>"; add "$2"; exit 0 ;;
esac

purpose="$1"; shift
valid_purpose "$purpose" || die "bad purpose name '$purpose'"
[[ "${1:-}" == "--" ]] && shift
[[ $# -gt 0 ]] || die "usage: $prog <purpose> -- <command...>"
file="$dir/$purpose.env"
[[ -r "$file" ]] || die "no purpose '$purpose' on this machine. See: $prog --list (or run chezmoi update)"

# Remove every variable any purpose defines, then load only the chosen one.
shopt -s nullglob
for f in "$dir"/*.env; do
  while IFS=$'\t' read -r k _; do unset "$k"; done < <(parse "$f")
done
while IFS=$'\t' read -r k v; do export "$k=$v"; done < <(parse "$file")
exec "$@"
