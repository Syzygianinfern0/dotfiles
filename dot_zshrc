# ~/.zshrc — managed by chezmoi (Starship + curated plugins). PATH is set in
# ~/.zshenv / ~/.zprofile. Plugins come from brew or ~/.local/share/zsh/plugins.

# Source the first existing file from a list of candidate plugin paths.
_zsrc() { local f; for f in "$@"; do [ -r "$f" ] && { source "$f"; return 0; }; done; return 1; }
_ZPLUG="$HOME/.local/share/zsh/plugins"

# ── History ───────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # share history across sessions live
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicate entries
setopt HIST_IGNORE_SPACE      # don't record commands starting with a space
setopt HIST_REDUCE_BLANKS     # trim superfluous whitespace
setopt EXTENDED_HISTORY       # record timestamps

# ── Navigation / QoL options ──────────────────────────────────────────
setopt AUTO_CD                # `foo` == `cd foo` if foo is a dir
setopt INTERACTIVE_COMMENTS   # allow # comments in interactive shell

# ── Key bindings ──────────────────────────────────────────────────────
bindkey -e                              # emacs keymap (arrow/word motions)
# Treat '/' as a word boundary so word-wise motions/deletes act on one
# path segment at a time (e.g. Option+Backspace deletes one directory).
WORDCHARS=${WORDCHARS//[\/]/}
bindkey '^[^?' backward-kill-word       # Option+Backspace (iTerm2 Left Option = "Esc+")
bindkey '^[^H' backward-kill-word

# ── Completion ────────────────────────────────────────────────────────
[ -n "$BREW_PREFIX" ] && FPATH="$BREW_PREFIX/share/zsh/site-functions:$FPATH"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive

# Feed ~/.ssh/config Host aliases (+ known_hosts) to completion so they
# complete and highlight as valid.
() {
  local -aU _cfg_hosts
  [[ -r ~/.ssh/config ]] && _cfg_hosts+=(
    ${(f)"$(awk 'tolower($1)=="host"{for(i=2;i<=NF;i++) if($i !~ /[*?]/) print $i}' ~/.ssh/config)"}
  )
  [[ -r ~/.ssh/known_hosts ]] && _cfg_hosts+=(
    ${${${${(f)"$(<~/.ssh/known_hosts)"}:#[|#]*}%%\ *}%%,*}
  )
  (( $#_cfg_hosts )) && zstyle ':completion:*:hosts' hosts $_cfg_hosts
}

# fast-syntax-highlighting must be sourced BEFORE zsh-autocomplete (otherwise
# "unhandled ZLE widget" warnings).
_zsrc "$BREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" \
      "$_ZPLUG/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# zsh-autocomplete (runs compinit itself; Up = history menu). Needs zsh >= 5.8.
autoload -Uz is-at-least
is-at-least 5.8 && _zsrc "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" \
      "$_ZPLUG/zsh-autocomplete/zsh-autocomplete.plugin.zsh"

# Fallback: if zsh-autocomplete wasn't loaded, run compinit ourselves.
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }

# ── fzf (fuzzy finder): Ctrl-R history, Ctrl-T files, Alt-C cd ─────────
command -v fzf &>/dev/null && eval "$(fzf --zsh 2>/dev/null)"
# Use fd for file/dir listings: faster, respects .gitignore, shows dotfiles.
if command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

# ── zoxide (smarter cd; use `z <dir>` and `zi` for interactive) ────────
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# ── Aliases (eza + bat replacements) ──────────────────────────────────
if command -v eza &>/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lg --group-directories-first --icons=auto'
  alias la='eza -lag --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --icons=auto'
fi
if command -v bat &>/dev/null; then
  alias cat='bat --paging=never'
  export BAT_THEME="ansi"
fi

# brew: update definitions, upgrade formulae, then clean up old versions
alias brewup='brew update && brew upgrade && brew cleanup'

# Personal aliases/functions (tmux, DJI, ...)
[ -r ~/.zsh/zsh_aliases ] && source ~/.zsh/zsh_aliases

# ── zsh-autosuggestions: fish-style ghost-text suggestions from history ─
_zsrc "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
      "$_ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'          # dim grey suggestion
ZSH_AUTOSUGGEST_STRATEGY=(history completion)   # also suggest from completion
bindkey '^ ' autosuggest-accept                 # Ctrl-Space to accept

# ── Starship prompt ───────────────────────────────────────────────────
command -v starship &>/dev/null && eval "$(starship init zsh)"

# ── Per-machine overrides + secrets (machine-local, NOT tracked) ───────
[ -r "$HOME/.config/zsh/local.zsh" ] && source "$HOME/.config/zsh/local.zsh"
unset -f _zsrc; unset _ZPLUG
