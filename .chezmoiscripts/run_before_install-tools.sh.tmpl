#!/usr/bin/env bash
# chezmoi bootstrap — installs the shell tool stack. Runs on every apply but
# exits immediately when everything is already present, so failed installs
# (no network, rate limits) are retried on the next apply.
#
# RESILIENT BY DESIGN: install failures are logged but NEVER abort
# `chezmoi apply`; the shell config guards every tool/plugin. Always exits 0.
#
#   macOS:            Homebrew (installed if missing).
#   Linux with brew:  Homebrew (linuxbrew); falls through if brew fails.
#   Linux, no brew:   user-local fallback, no sudo — binaries into ~/.local/bin,
#                     zsh plugins cloned into ~/.local/share/zsh/plugins.
#                     Set GITHUB_TOKEN to avoid GitHub API rate limits.

# TOOLS = command names (presence check); BREW_PKGS = formula names.
TOOLS="starship zoxide fzf eza bat duf dust btop git-lfs rg fd delta gh jq"
BREW_PKGS="starship zoxide fzf eza bat duf dust btop git-lfs ripgrep fd git-delta gh jq"
BIN="$HOME/.local/bin"
PLUG="$HOME/.local/share/zsh/plugins"
export PATH="$BIN:$PATH"

have() { command -v "$1" >/dev/null 2>&1; }
log()  { printf '    %s\n' "$*"; }
warn() { printf '    [warn] %s\n' "$*" >&2; }

# Only use a brew we own (-O): another user's shared linuxbrew would run their
# binaries as us (and installs into it fail anyway). Matches ~/.zshenv.
find_brew() {
  local c
  for c in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew" "$(command -v brew 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && [ -O "$c" ] && { echo "$c"; return; }
  done
}
BREW="$(find_brew)"
[ -n "$BREW" ] && eval "$("$BREW" shellenv)" 2>/dev/null

# plugin_ok <brew-relative path> <fallback path>
plugin_ok() { { [ -n "${HOMEBREW_PREFIX:-}" ] && [ -r "$HOMEBREW_PREFIX/$1" ]; } || [ -r "$PLUG/$2" ]; }

all_present() {
  local t; for t in $TOOLS; do have "$t" || return 1; done
  fzf --zsh >/dev/null 2>&1 || return 1                   # fzf too old for `--zsh`
  plugin_ok share/zsh-autosuggestions/zsh-autosuggestions.zsh zsh-autosuggestions/zsh-autosuggestions.zsh &&
  plugin_ok opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh &&
  plugin_ok share/zsh-autocomplete/zsh-autocomplete.plugin.zsh zsh-autocomplete/zsh-autocomplete.plugin.zsh
{{- if eq .chezmoi.os "darwin" }} &&
  { [ -d /Applications/Ghostty.app ] || [ -d "$HOME/Applications/Ghostty.app" ]; }
{{- end }}
}
# ── uv + default Python (all OSes) ────────────────────────────────────
# Standalone uv in ~/.local/bin, and a uv-managed CPython as the default
# `python`/`python3` (links in ~/.local/bin, ahead of /usr/bin on PATH).
# System Python is untouched; projects still pin their own via `uv run`.
PY_DEFAULT=3.14
if ! have uv; then
  log "uv not found; installing standalone uv into $BIN..."
  curl -LsSf https://astral.sh/uv/install.sh \
    | env UV_INSTALL_DIR="$BIN" UV_NO_MODIFY_PATH=1 sh >/dev/null 2>&1 \
    || warn "uv install failed."
fi
if have uv && ! "$BIN/python3" -c "import sys; sys.exit(sys.version_info[:2] != tuple(map(int, '$PY_DEFAULT'.split('.'))))" >/dev/null 2>&1; then
  uv python install "$PY_DEFAULT" --default >/dev/null 2>&1 \
    && log "python/python3 -> uv CPython $PY_DEFAULT ($BIN)" \
    || warn "uv python install $PY_DEFAULT --default failed."
fi

all_present && exit 0

echo "==> chezmoi bootstrap: installing missing shell tools"

{{ if eq .chezmoi.os "darwin" -}}
if [ -z "$BREW" ]; then
  log "Homebrew not found; attempting non-interactive install..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || warn "Homebrew install failed."
  BREW="$(find_brew)"
  [ -n "$BREW" ] && eval "$("$BREW" shellenv)" 2>/dev/null
fi
{{ end -}}

if [ -n "$BREW" ]; then
  if "$BREW" install $BREW_PKGS zsh-autosuggestions zsh-fast-syntax-highlighting zsh-autocomplete; then
{{- if eq .chezmoi.os "darwin" }}
    "$BREW" install --cask font-meslo-lg-nerd-font || warn "font cask install skipped."
    [ -d /Applications/Ghostty.app ] || [ -d "$HOME/Applications/Ghostty.app" ] \
      || "$BREW" install --cask ghostty || warn "ghostty cask install skipped."
{{- end }}
    echo "==> bootstrap done (Homebrew)."
    exit 0
  fi
  warn "brew install failed (e.g. shared, read-only linuxbrew); trying user-local fallback."
fi

# ── No-brew fallback (Linux clusters / no sudo) ───────────────────────
log "Using user-local fallback (~/.local/bin)."
mkdir -p "$BIN" "$PLUG"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

case "$(uname -m)" in
  x86_64|amd64)  ARCH=x86_64;  GOARCH=amd64; DUFARCH=x86_64 ;;
  aarch64|arm64) ARCH=aarch64; GOARCH=arm64; DUFARCH=arm64 ;;
  *) ARCH=""; warn "Unknown arch $(uname -m); skipping binary downloads." ;;
esac

GH_AUTH=(); [ -n "${GITHUB_TOKEN:-}" ] && GH_AUTH=(-H "Authorization: Bearer $GITHUB_TOKEN")

# gh_asset <owner/repo> <regex>... -> URL of the first asset matching the
# earliest regex (so list musl before gnu to prefer static builds).
gh_asset() {
  local repo="$1" urls re u; shift
  urls="$(curl -fsSL "${GH_AUTH[@]}" "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
    | grep -o '"browser_download_url": *"[^"]*"' | cut -d'"' -f4)"
  for re in "$@"; do
    u="$(printf '%s\n' "$urls" | grep -E "$re" | head -1)"
    [ -n "$u" ] && { echo "$u"; return; }
  done
}

# install_release <name> <owner/repo> <regex>...: downloads the latest release
# tarball, extracts it and copies the binary into $BIN.
install_release() {
  local name="$1" repo="$2" url f d; shift 2; d="$TMP/$name"
  url="$(gh_asset "$repo" "$@")"
  [ -n "$url" ] || { warn "$name: no release asset found (rate-limited? set GITHUB_TOKEN)"; return 1; }
  mkdir -p "$d"; f="$d/${url##*/}"
  curl -fsSL -o "$f" "$url" && tar xf "$f" -C "$d" || { warn "$name: download/extract failed"; return 1; }
  local c; shopt -s globstar nullglob
  for c in "$d"/**/"$name"; do [ -f "$c" ] && { install -m 755 "$c" "$BIN/$name"; break; }; done
  [ -x "$BIN/$name" ] || { warn "$name: binary not found in ${url##*/}"; return 1; }
  verify_bin "$name"
}

# install_raw <name> <owner/repo> <regex>...: for releases that ship a bare
# binary instead of a tarball (e.g. jq).
install_raw() {
  local name="$1" repo="$2" url; shift 2
  url="$(gh_asset "$repo" "$@")"
  [ -n "$url" ] || { warn "$name: no release asset found (rate-limited? set GITHUB_TOKEN)"; return 1; }
  curl -fsSL -o "$TMP/$name.bin" "$url" && install -m 755 "$TMP/$name.bin" "$BIN/$name" \
    || { warn "$name: download failed"; return 1; }
  verify_bin "$name"
}

# verify_bin <name>: a glibc build can be too new for an old distro (e.g. Rocky
# 8). Remove a binary that can't run, so `command -v` guards stay truthful.
verify_bin() {
  if "$BIN/$1" --version >/dev/null 2>&1; then log "$1 installed -> $BIN/$1"
  else rm -f "$BIN/$1"; warn "$1: downloaded binary does not run here; removed"; return 1; fi
}

if [ -n "$ARCH" ]; then
  have starship || curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$BIN" >/dev/null \
    || warn "starship install failed"
  have zoxide || curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
    | sh -s -- --bin-dir "$BIN" >/dev/null || warn "zoxide install failed"
  fzf --zsh >/dev/null 2>&1 || install_release fzf junegunn/fzf "linux_${GOARCH}\.tar\.gz$"
  have eza     || install_release eza eza-community/eza "eza_${ARCH}-unknown-linux-musl\.tar\.gz$" "eza_${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have bat     || install_release bat sharkdp/bat "bat-v.*-${ARCH}-unknown-linux-musl\.tar\.gz$" "bat-v.*-${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have duf     || install_release duf muesli/duf "duf_.*_linux_${DUFARCH}\.tar\.gz$"
  have dust    || install_release dust bootandy/dust "dust-v.*-${ARCH}-unknown-linux-musl\.tar\.gz$" "dust-v.*-${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have rg      || install_release rg BurntSushi/ripgrep "ripgrep-.*-${ARCH}-unknown-linux-musl\.tar\.gz$" "ripgrep-.*-${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have fd      || install_release fd sharkdp/fd "fd-v.*-${ARCH}-unknown-linux-musl\.tar\.gz$" "fd-v.*-${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have delta   || install_release delta dandavison/delta "delta-.*-${ARCH}-unknown-linux-musl\.tar\.gz$" "delta-.*-${ARCH}-unknown-linux-gnu\.tar\.gz$"
  have gh      || install_release gh cli/cli "gh_.*_linux_${GOARCH}\.tar\.gz$"
  have jq      || install_raw jq jqlang/jq "jq-linux-${GOARCH}$"
  have btop    || install_release btop aristocratos/btop "btop-${ARCH}-(unknown-)?linux-musl\.(tar\.gz|tbz)$"
  have git-lfs || install_release git-lfs git-lfs/git-lfs "git-lfs-linux-${GOARCH}-v.*\.tar\.gz$"
fi

# latest_tag <owner/repo> -> tag of the latest GitHub release (empty if none).
latest_tag() {
  curl -fsSL "${GH_AUTH[@]}" "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
    | grep -o '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4
}
# clone_plugin <name> <owner/repo> [release]: shallow-clone the default branch,
# or the latest release tag when "release" is given (for plugins whose default
# branch can be broken between releases, e.g. zsh-autocomplete).
clone_plugin() {
  [ -d "$PLUG/$1" ] && return 0
  local ref=""; [ "${3:-}" = release ] && ref="$(latest_tag "$2")"
  [ "${3:-}" = release ] && [ -z "$ref" ] && warn "plugin $1: no release tag found; using default branch"
  git clone -q --depth=1 ${ref:+--branch "$ref"} "https://github.com/$2" "$PLUG/$1" \
    && log "plugin $1${ref:+ ($ref)} -> $PLUG/$1" || warn "plugin $1 clone failed"
}
if have git; then
  clone_plugin zsh-autosuggestions zsh-users/zsh-autosuggestions
  clone_plugin fast-syntax-highlighting zdharma-continuum/fast-syntax-highlighting
  clone_plugin zsh-autocomplete marlonrichert/zsh-autocomplete release
else
  warn "git not found; skipping zsh plugins."
fi

echo "==> bootstrap done (fallback)."
exit 0
