#!/usr/bin/env bash
# chezmoi bootstrap — installs the shell tool stack on a new machine.
#
# RESILIENT BY DESIGN: install failures are logged but NEVER abort
# `chezmoi apply`. The .zshrc guards every tool/plugin, so missing tools just
# mean features are skipped — the shell still works. Always exits 0.
#
#   macOS:            Homebrew (installed if missing).
#   Linux with brew:  Homebrew (linuxbrew).
#   Linux, no brew:   user-local fallback, no sudo — binaries into ~/.local/bin,
#                     zsh plugins cloned into ~/.local/share/zsh/plugins.
#
# Re-runs whenever the tool list below changes:
# tools hash: {{ list "starship" "zoxide" "fzf" "eza" "bat" "duf" "dust" "btop" "rclone" "zsh-autosuggestions" "zsh-fast-syntax-highlighting" "zsh-autocomplete" "fallback-v2" | join "," | sha256sum }}

echo "==> chezmoi bootstrap: ensuring shell tools are installed"
log()  { printf '    %s\n' "$*"; }
warn() { printf '    [warn] %s\n' "$*" >&2; }

find_brew() {
  for c in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    [ -x "$c" ] && { echo "$c"; return; }
  done
  command -v brew 2>/dev/null
}
BREW="$(find_brew)"

{{ if eq .chezmoi.os "darwin" -}}
# macOS: install Homebrew if missing (best effort).
if [ -z "$BREW" ]; then
  log "Homebrew not found; attempting non-interactive install..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || warn "Homebrew install failed."
  BREW="$(find_brew)"
fi
{{ end -}}

if [ -n "$BREW" ]; then
  eval "$("$BREW" shellenv)" 2>/dev/null || true
  "$BREW" install starship zoxide fzf eza bat duf dust btop rclone \
    zsh-autosuggestions zsh-fast-syntax-highlighting zsh-autocomplete \
    || warn "One or more formulae failed to install; continuing anyway."
{{- if eq .chezmoi.os "darwin" }}
  "$BREW" install --cask font-meslo-lg-nerd-font || warn "font cask install skipped."
{{- end }}
  echo "==> bootstrap done (Homebrew). Open a new shell to load everything."
  exit 0
fi

# ── No-brew fallback (Linux clusters / no sudo) ───────────────────────
log "Homebrew unavailable — using user-local fallback (~/.local/bin)."
BIN="$HOME/.local/bin"
PLUG="$HOME/.local/share/zsh/plugins"
mkdir -p "$BIN" "$PLUG"
export PATH="$BIN:$PATH"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

case "$(uname -m)" in
  x86_64|amd64)  ARCH=x86_64;  GOARCH=amd64; DUFARCH=x86_64 ;;
  aarch64|arm64) ARCH=aarch64; GOARCH=arm64; DUFARCH=arm64 ;;
  *) ARCH=""; warn "Unknown arch $(uname -m); skipping binary downloads." ;;
esac

have() { command -v "$1" >/dev/null 2>&1; }

# gh_asset <owner/repo> <regex> -> latest release asset URL
gh_asset() {
  curl -fsSL "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
    | grep -o '"browser_download_url": *"[^"]*"' | cut -d'"' -f4 | grep -E "$2" | head -1
}

# install_release <name> <owner/repo> <regex>: downloads the latest release
# archive (.tar.gz/.tbz/.zip), extracts it and copies the binary into $BIN.
install_release() {
  local url f d="$TMP/$1"; url="$(gh_asset "$2" "$3")"
  [ -n "$url" ] || { warn "$1: no release asset found"; return 1; }
  mkdir -p "$d"; f="$d/${url##*/}"
  curl -fsSL -o "$f" "$url" || { warn "$1: download failed"; return 1; }
  case "$f" in
    *.zip) if have unzip; then unzip -q "$f" -d "$d"; else python3 -m zipfile -e "$f" "$d"; fi ;;
    *)     tar xf "$f" -C "$d" ;;
  esac || { warn "$1: extract failed"; return 1; }
  find "$d" -type f -name "$1" -exec install -m 755 {} "$BIN/$1" \; -quit
  [ -x "$BIN/$1" ] && log "$1 installed -> $BIN/$1"
}

if [ -n "$ARCH" ]; then
  have starship || curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$BIN" >/dev/null \
    || warn "starship install failed"
  have zoxide || curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
    | sh -s -- --bin-dir "$BIN" >/dev/null || warn "zoxide install failed"
  # fzf: also replace an old distro fzf that lacks `fzf --zsh`
  { have fzf && fzf --zsh >/dev/null 2>&1; } || install_release fzf junegunn/fzf "linux_${GOARCH}\.tar\.gz$" || true
  have eza    || install_release eza eza-community/eza "eza_${ARCH}-unknown-linux-(musl|gnu)\.tar\.gz$" || true
  have bat    || install_release bat sharkdp/bat "bat-v.*-${ARCH}-unknown-linux-(musl|gnu)\.tar\.gz$" || true
  have duf    || install_release duf muesli/duf "duf_.*_linux_${DUFARCH}\.tar\.gz$" || true
  have dust   || install_release dust bootandy/dust "dust-v.*-${ARCH}-unknown-linux-(musl|gnu)\.tar\.gz$" || true
  have btop   || install_release btop aristocratos/btop "btop-${ARCH}-(unknown-)?linux-musl\.tbz$" || true
  have rclone || install_release rclone rclone/rclone "rclone-v.*-linux-${GOARCH}\.zip$" || true
fi

clone_plugin() {
  [ -d "$PLUG/$1" ] && return 0
  git clone -q --depth=1 "$2" "$PLUG/$1" && log "plugin $1 -> $PLUG/$1" || warn "plugin $1 clone failed"
}
if have git; then
  clone_plugin zsh-autosuggestions https://github.com/zsh-users/zsh-autosuggestions
  clone_plugin fast-syntax-highlighting https://github.com/zdharma-continuum/fast-syntax-highlighting
  clone_plugin zsh-autocomplete https://github.com/marlonrichert/zsh-autocomplete
else
  warn "git not found; skipping zsh plugins."
fi

echo "==> bootstrap done (fallback). Open a new shell to load everything."
exit 0
