# ~/.zshenv — managed by chezmoi. Sourced by EVERY zsh (interactive,
# non-interactive, scripts), so PATH lives here. Login shells re-assert it in
# ~/.zprofile because /etc/zprofile (macOS path_helper) reorders it.

typeset -U path   # auto-dedupe entries

# ── Homebrew prefix (macOS Apple Silicon/Intel, linuxbrew system/user) ─
if [ -d /opt/homebrew ]; then
  BREW_PREFIX=/opt/homebrew
elif [ -d /usr/local/Homebrew ]; then
  BREW_PREFIX=/usr/local
elif [ -d /home/linuxbrew/.linuxbrew ]; then
  BREW_PREFIX=/home/linuxbrew/.linuxbrew
elif [ -d "$HOME/.linuxbrew" ]; then
  BREW_PREFIX="$HOME/.linuxbrew"
fi
export BREW_PREFIX

# ── PATH (prepended in reverse priority; ~/bin ends up first) ──────────
[ -n "$BREW_PREFIX" ] && path=("$BREW_PREFIX/bin" "$BREW_PREFIX/sbin" $path)
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "$HOME/bin" ]] && path=("$HOME/bin" $path)

export EDITOR=nano

# Ubuntu's /etc/zsh/zshrc runs compinit itself; let zsh-autocomplete do it.
skip_global_compinit=1

# ── Machine-local env (NOT tracked by chezmoi/git) — this device only ──
[ -r "$HOME/.config/zsh/env.local" ] && source "$HOME/.config/zsh/env.local"
