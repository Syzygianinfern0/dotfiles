# ~/.config/ghostty/config — managed by chezmoi. Docs: https://ghostty.org/docs/config
# Only settings that differ from the defaults. List all: `ghostty +show-config --default --docs`
# No font set: Ghostty's built-in JetBrains Mono ships with Nerd Font symbols,
# so Starship/ccstatusline glyphs render without a patched font.

# Reopen windows, tabs and splits (with their directories) after a restart.
window-save-state = always

# Left Option acts as Alt/Meta (Option+Backspace / Option+arrows word motions,
# Alt shortcuts in TUIs); Right Option still types special characters.
macos-option-as-alt = left

# Auto-install Ghostty's terminfo on SSH hosts (falls back to xterm-256color),
# so remote tmux/nano/htop don't complain about an unknown TERM. Needs no sudo.
shell-integration-features = ssh-env,ssh-terminfo

mouse-hide-while-typing = true
