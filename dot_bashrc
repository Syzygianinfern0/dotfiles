# ~/.bashrc — managed by chezmoi (Linux only). zsh is the interactive shell
# (see ~/.bash_profile); bash still runs `ssh host cmd`, `bash -lc cmd`, agent
# backends, and is the fallback when zsh is missing.

# ── PATH: same order as ~/.zshenv. Set BEFORE the interactive check so
# non-interactive `ssh host cmd` also finds uv, gh, chezmoi, ...
_path_prepend() {
  [ -d "$1" ] || return 0
  PATH=":$PATH:"; PATH="${PATH//:$1:/:}"; PATH="${PATH#:}"; PATH="${PATH%:}"
  PATH="$1${PATH:+:$PATH}"
}
# Only trust a brew owned by us (-O), like ~/.zshenv.
for _b in /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
  if [ -O "$_b" ]; then _path_prepend "$_b/sbin"; _path_prepend "$_b/bin"; break; fi
done
_path_prepend "$HOME/.local/bin"
_path_prepend "$HOME/bin"
unset _b; unset -f _path_prepend
export PATH
export EDITOR=nano

# ── Non-interactive: stop here ─────────────────────────────────────────
case $- in *i*) ;; *) return ;; esac
# Agent backends (Codex, Cursor) start an interactive bash with no terminal:
# skip prompt, completion and key bindings there.
if [ -n "${CODEX_REMOTE_PAYLOAD:-}${CURSOR_AGENT:-}${BASH_EXECUTION_STRING:-}" ] && [ ! -t 0 ]; then
  return
fi

# ── Interactive bash (fallback shell) ──────────────────────────────────
HISTCONTROL=ignoreboth
HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend checkwinsize

if ! shopt -oq posix; then
  if [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -r /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash 2>/dev/null)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
# eza aliases are for humans only: Claude Code (CLAUDECODE=1) replays this
# shell's aliases for agent commands, and eza breaks flags like ls -lt.
if [ -z "${CLAUDECODE:-}" ] && command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lg --group-directories-first --icons=auto'
  alias la='eza -lag --group-directories-first --icons=auto'
else
  alias ls='ls --color=auto'
fi
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"

# Per-machine overrides (machine-local, NOT tracked).
[ -r "$HOME/.config/bash/local.bash" ] && . "$HOME/.config/bash/local.bash"
